import processing.serial.*;
Serial myPort;
PImage logo;

int bgcolor = 0;

void setup() {
  size(1, 1);
  surface.setResizable(true);
  colorMode(HSB, 255);
  
  logo = loadImage("https://europe1.discourse-cdn.com/arduino/original/4X/6/9/2/692a51906007705eba0cb142c822bc9b81a9c3b9.png");
  surface.setSize(logo.width, logo.height);
  
  // Use the port named like `/dev/tty.usbmodem1101`
  println("Available serial ports:");
  println(Serial.list());
  
  myPort = new Serial(this, Serial.list()[5], 9600);
}

void draw() {
  // Drain buffer and use only the most recent value
  // The arduino may send more to the buffer than Processing can read in its loop.
  // Using a while loop instead of a conditional ensures that we're not 
  while(myPort.available() > 0){
    bgcolor = myPort.read();
  }
  background(bgcolor, 255, 255);
  image(logo, 0, 0);
}
